<!doctype html>
<html lang="en" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Titration Lab</title>
  <script src="/_sdk/element_sdk.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      box-sizing: border-box;
    }
    
    .drop {
      animation: fall 0.8s ease-in;
    }
    
    @keyframes fall {
      0% {
        transform: translateY(-20px);
        opacity: 1;
      }
      100% {
        transform: translateY(0);
        opacity: 0;
      }
    }
    
    .burette-valve {
      cursor: pointer;
      transition: transform 0.3s ease;
    }
    
    .burette-valve:hover {
      transform: scale(1.1);
    }
    
    .endpoint-flash {
      animation: flash 0.5s ease-in-out;
    }
    
    @keyframes flash {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
  </style>
  <style>@view-transition { navigation: auto; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
 </head>
 <body class="h-full">
  <main id="app-wrapper" class="h-full w-full overflow-auto">
   <div class="min-h-full p-8">
    <header class="text-center mb-8">
     <h1 id="lab-title" class="text-4xl font-bold mb-4">Ammonia and Epsom Salt Reaction Lab</h1>
     <p id="instruction-text" class="text-lg max-w-3xl mx-auto">Add varying amounts of ammonia and water to Epsom salt to observe how reactant amounts affect product formation. Watch the chemical reaction: 2NH₃ + MgSO₄ + 2H₂O → Mg(OH)₂ + (NH₄)₂SO₄</p><!-- Experiment Part Selector -->
     <div class="mt-6 flex justify-center gap-4"><button id="part1-btn" class="experiment-part-btn px-6 py-3 rounded-lg font-semibold transition-all hover:scale-105 border-2"> Part 1: Vary Ammonia </button> <button id="part2-btn" class="experiment-part-btn px-6 py-3 rounded-lg font-semibold transition-all hover:scale-105 border-2"> Part 2: Vary Epsom Salt </button>
     </div>
     <p id="experiment-description" class="text-sm mt-4 max-w-2xl mx-auto"></p>
    </header>
    <div class="max-w-7xl mx-auto">
     <div class="grid grid-cols-1 lg:grid-cols-3 gap-8"><!-- Titration Setup -->
      <div class="lg:col-span-2">
       <div class="p-6 rounded-lg border-2">
        <h2 class="text-2xl font-semibold mb-6">Titration Setup</h2><!-- Chemical Addition Controls -->
        <div class="mb-8 p-4 rounded-lg border-2">
         <h3 class="text-lg font-semibold mb-4">Add Chemicals to Selected Bottle</h3><!-- Bottle Selector -->
         <div class="mb-4 flex gap-3 justify-center"><button class="bottle-selector-btn px-4 py-2 rounded font-medium transition-all hover:scale-105 border-2" data-bottle="1"> Select Bottle 1 </button> <button class="bottle-selector-btn px-4 py-2 rounded font-medium transition-all hover:scale-105 border-2" data-bottle="2"> Select Bottle 2 </button> <button class="bottle-selector-btn px-4 py-2 rounded font-medium transition-all hover:scale-105 border-2" data-bottle="3"> Select Bottle 3 </button>
         </div>
         <p id="selected-bottle-text" class="text-center font-semibold mb-4">No bottle selected</p>
         <div class="grid grid-cols-1 md:grid-cols-3 gap-4"><!-- Epsom Salt -->
          <div class="p-3 rounded border">
           <div class="font-semibold mb-2 text-center">
            Epsom Salt (MgSO₄)
           </div>
           <div class="flex gap-2"><button class="add-chemical-btn flex-1 py-2 px-3 rounded text-sm font-medium transition-all hover:scale-105" data-chemical="epsom" data-amount="tablespoon" disabled> + 1 Tbsp </button> <button class="add-chemical-btn flex-1 py-2 px-3 rounded text-sm font-medium transition-all hover:scale-105" data-chemical="epsom" data-amount="third-cup" disabled> + 1/3 Cup </button>
           </div>
          </div><!-- Water -->
          <div class="p-3 rounded border">
           <div class="font-semibold mb-2 text-center">
            Water (H₂O)
           </div>
           <div class="flex gap-2"><button class="add-chemical-btn flex-1 py-2 px-3 rounded text-sm font-medium transition-all hover:scale-105" data-chemical="water" data-amount="tablespoon" disabled> + 1 Tbsp </button> <button class="add-chemical-btn flex-1 py-2 px-3 rounded text-sm font-medium transition-all hover:scale-105" data-chemical="water" data-amount="third-cup" disabled> + 1/3 Cup </button>
           </div>
          </div><!-- Ammonia -->
          <div class="p-3 rounded border">
           <div class="font-semibold mb-2 text-center">
            Ammonia (NH₃)
           </div>
           <div class="flex gap-2"><button class="add-chemical-btn flex-1 py-2 px-3 rounded text-sm font-medium transition-all hover:scale-105" data-chemical="ammonia" data-amount="tablespoon" disabled> + 1 Tbsp </button> <button class="add-chemical-btn flex-1 py-2 px-3 rounded text-sm font-medium transition-all hover:scale-105" data-chemical="ammonia" data-amount="third-cup" disabled> + 1/3 Cup </button>
           </div>
          </div>
         </div>
        </div>
        <div class="flex justify-center items-start mb-8"><!-- Three Bottles -->
         <div class="flex gap-8 justify-center"><!-- Bottle 1 -->
          <div class="text-center">
           <svg width="100" height="180" viewbox="0 0 100 180"><!-- Bottle body --> <rect x="20" y="30" width="60" height="140" rx="5" fill="none" stroke="#444" stroke-width="3" /> <!-- Bottle cap --> <rect x="30" y="20" width="40" height="15" rx="3" fill="#666" stroke="#444" stroke-width="2" /> <!-- Liquid --> <clippath id="bottle1-clip">
             <rect x="20" y="30" width="60" height="140" rx="5" />
            </clippath> <rect id="bottle1-liquid" x="20" y="170" width="60" height="0" clip-path="url(#bottle1-clip)" class="transition-all duration-500" />
           </svg>
           <p class="font-bold mt-2">Bottle 1</p>
           <p id="bottle1-amounts" class="text-xs mt-1 opacity-75">Empty</p>
          </div><!-- Bottle 2 -->
          <div class="text-center">
           <svg width="100" height="180" viewbox="0 0 100 180"><!-- Bottle body --> <rect x="20" y="30" width="60" height="140" rx="5" fill="none" stroke="#444" stroke-width="3" /> <!-- Bottle cap --> <rect x="30" y="20" width="40" height="15" rx="3" fill="#666" stroke="#444" stroke-width="2" /> <!-- Liquid --> <clippath id="bottle2-clip">
             <rect x="20" y="30" width="60" height="140" rx="5" />
            </clippath> <rect id="bottle2-liquid" x="20" y="170" width="60" height="0" clip-path="url(#bottle2-clip)" class="transition-all duration-500" />
           </svg>
           <p class="font-bold mt-2">Bottle 2</p>
           <p id="bottle2-amounts" class="text-xs mt-1 opacity-75">Empty</p>
          </div><!-- Bottle 3 -->
          <div class="text-center">
           <svg width="100" height="180" viewbox="0 0 100 180"><!-- Bottle body --> <rect x="20" y="30" width="60" height="140" rx="5" fill="none" stroke="#444" stroke-width="3" /> <!-- Bottle cap --> <rect x="30" y="20" width="40" height="15" rx="3" fill="#666" stroke="#444" stroke-width="2" /> <!-- Liquid --> <clippath id="bottle3-clip">
             <rect x="20" y="30" width="60" height="140" rx="5" />
            </clippath> <rect id="bottle3-liquid" x="20" y="170" width="60" height="0" clip-path="url(#bottle3-clip)" class="transition-all duration-500" />
           </svg>
           <p class="font-bold mt-2">Bottle 3</p>
           <p id="bottle3-amounts" class="text-xs mt-1 opacity-75">Empty</p>
          </div>
         </div>
        </div><!-- Controls -->
        <div class="flex justify-center gap-4"><button id="reset-btn" class="py-3 px-6 rounded-lg font-semibold transition-all hover:scale-105 active:scale-95 border-2"> Reset Experiment </button>
        </div>
       </div>
      </div><!-- Data Panel -->
      <div class="space-y-6"><!-- Bottle 1 Amounts -->
       <div class="p-6 rounded-lg border-2">
        <h3 class="text-xl font-semibold mb-4">Bottle 1 Contents</h3>
        <div class="space-y-3 text-sm">
         <div class="flex justify-between"><span class="font-medium">Epsom Salt:</span> <span id="bottle1-epsom" class="font-bold">0 mL</span>
         </div>
         <div class="flex justify-between"><span class="font-medium">Water:</span> <span id="bottle1-water" class="font-bold">0 mL</span>
         </div>
         <div class="flex justify-between"><span class="font-medium">Ammonia:</span> <span id="bottle1-ammonia" class="font-bold">0 mL</span>
         </div>
         <div class="pt-2 border-t flex justify-between"><span class="font-semibold">Total Volume:</span> <span id="bottle1-total" class="font-bold">0 mL</span>
         </div>
        </div>
       </div><!-- Bottle 2 Amounts -->
       <div class="p-6 rounded-lg border-2">
        <h3 class="text-xl font-semibold mb-4">Bottle 2 Contents</h3>
        <div class="space-y-3 text-sm">
         <div class="flex justify-between"><span class="font-medium">Epsom Salt:</span> <span id="bottle2-epsom" class="font-bold">0 mL</span>
         </div>
         <div class="flex justify-between"><span class="font-medium">Water:</span> <span id="bottle2-water" class="font-bold">0 mL</span>
         </div>
         <div class="flex justify-between"><span class="font-medium">Ammonia:</span> <span id="bottle2-ammonia" class="font-bold">0 mL</span>
         </div>
         <div class="pt-2 border-t flex justify-between"><span class="font-semibold">Total Volume:</span> <span id="bottle2-total" class="font-bold">0 mL</span>
         </div>
        </div>
       </div><!-- Bottle 3 Amounts -->
       <div class="p-6 rounded-lg border-2">
        <h3 class="text-xl font-semibold mb-4">Bottle 3 Contents</h3>
        <div class="space-y-3 text-sm">
         <div class="flex justify-between"><span class="font-medium">Epsom Salt:</span> <span id="bottle3-epsom" class="font-bold">0 mL</span>
         </div>
         <div class="flex justify-between"><span class="font-medium">Water:</span> <span id="bottle3-water" class="font-bold">0 mL</span>
         </div>
         <div class="flex justify-between"><span class="font-medium">Ammonia:</span> <span id="bottle3-ammonia" class="font-bold">0 mL</span>
         </div>
         <div class="pt-2 border-t flex justify-between"><span class="font-semibold">Total Volume:</span> <span id="bottle3-total" class="font-bold">0 mL</span>
         </div>
        </div>
       </div><!-- Status -->
       <div id="status-box" class="p-6 rounded-lg border-2">
        <h3 class="text-xl font-semibold mb-2">Status</h3>
        <p id="status-text" class="text-sm">Choose Part 1 or Part 2 to begin the experiment.</p>
       </div>
      </div>
     </div>
    </div>
   </div>
  </main>
  <script>
    const defaultConfig = {
      background_color: "#f0f9ff",
      surface_color: "#ffffff",
      text_color: "#0f172a",
      primary_action_color: "#3b82f6",
      secondary_action_color: "#94a3b8",
      font_family: "system-ui",
      font_size: 16,
      lab_title: "Ammonia and Epsom Salt Reaction Lab",
      instruction_text: "Add varying amounts of ammonia and water to Epsom salt to observe how reactant amounts affect product formation. Watch the chemical reaction: 2NH₃ + MgSO₄ + 2H₂O → Mg(OH)₂ + (NH₄)₂SO₄",
      analyte_label: "Add chemicals to observe the reaction",
      titrant_label: "",
      button_text: "Reset Experiment"
    };

    let currentPart = null; // 'part1' or 'part2'
    let selectedBottle = null; // 1, 2, or 3
    
    // Track chemicals added to each bottle (in mL)
    let bottles = {
      1: { epsom: 0, water: 0, ammonia: 0 },
      2: { epsom: 0, water: 0, ammonia: 0 },
      3: { epsom: 0, water: 0, ammonia: 0 }
    };
    
    const TABLESPOON_ML = 14.787; // 1 tablespoon = 14.787 mL
    const THIRD_CUP_ML = 78.863;  // 1/3 cup = 78.863 mL

    // Calculate flask appearance based on chemicals
    function calculateFlaskColor(bottleNum) {
      const bottle = bottles[bottleNum];
      const epsomVolume = bottle.epsom;
      const ammoniaVolume = bottle.ammonia;
      const waterVolume = bottle.water;
      
      const totalVolume = epsomVolume + ammoniaVolume + waterVolume;
      
      if (totalVolume === 0) {
        return { hex: '#e0f2fe', name: 'Empty' };
      }
      
      // If there's Epsom salt and ammonia, show precipitate forming (cloudy white)
      if (epsomVolume > 0 && ammoniaVolume > 0) {
        // More ammonia = more precipitate = cloudier/whiter
        const reactionRatio = Math.min(ammoniaVolume / epsomVolume, 2);
        const cloudiness = Math.min(reactionRatio * 0.5, 0.9);
        const whiteValue = Math.floor(200 + (255 - 200) * cloudiness);
        const hex = `#${whiteValue.toString(16).padStart(2, '0')}${whiteValue.toString(16).padStart(2, '0')}${whiteValue.toString(16).padStart(2, '0')}`;
        return { hex, name: 'Cloudy White (Mg(OH)₂)' };
      }
      
      // Just Epsom salt (slightly cloudy)
      if (epsomVolume > 0) {
        return { hex: '#f0f9ff', name: 'Epsom Salt solution' };
      }
      
      // Just ammonia (clear with slight yellow tint)
      if (ammoniaVolume > 0) {
        return { hex: '#fffbeb', name: 'Ammonia solution' };
      }
      
      // Just water
      return { hex: '#e0f2fe', name: 'Water' };
    }
    
    function selectBottle(bottleNum) {
      selectedBottle = bottleNum;
      
      // Update UI
      document.querySelectorAll('.bottle-selector-btn').forEach(btn => {
        if (btn.dataset.bottle === String(bottleNum)) {
          btn.style.fontWeight = 'bold';
          btn.style.borderWidth = '3px';
        } else {
          btn.style.fontWeight = 'normal';
          btn.style.borderWidth = '2px';
        }
      });
      
      document.getElementById('selected-bottle-text').textContent = `Selected: Bottle ${bottleNum}`;
      
      // Enable chemical buttons
      document.querySelectorAll('.add-chemical-btn').forEach(btn => {
        btn.disabled = false;
      });
      
      updateStatus(`Bottle ${bottleNum} selected. Add chemicals using the buttons above.`);
    }
    
    function addChemicalToBottle(chemical, amount) {
      if (!selectedBottle) {
        updateStatus('Please select a bottle first!');
        return;
      }
      
      const volumeML = amount === 'tablespoon' ? TABLESPOON_ML : THIRD_CUP_ML;
      bottles[selectedBottle][chemical] += volumeML;
      
      updateBottleDisplay(selectedBottle);
      
      const amountText = amount === 'tablespoon' ? '1 Tbsp' : '1/3 Cup';
      const chemicalNames = {
        epsom: 'Epsom Salt',
        water: 'Water',
        ammonia: 'Ammonia'
      };
      
      const flaskColor = calculateFlaskColor(selectedBottle);
      updateStatus(`Added ${amountText} of ${chemicalNames[chemical]} to Bottle ${selectedBottle}. ${flaskColor.name}`);
    }
    
    function updateBottleDisplay(bottleNum) {
      const bottle = bottles[bottleNum];
      
      // Update text amounts
      document.getElementById(`bottle${bottleNum}-epsom`).textContent = bottle.epsom.toFixed(1) + ' mL';
      document.getElementById(`bottle${bottleNum}-water`).textContent = bottle.water.toFixed(1) + ' mL';
      document.getElementById(`bottle${bottleNum}-ammonia`).textContent = bottle.ammonia.toFixed(1) + ' mL';
      
      const total = bottle.epsom + bottle.water + bottle.ammonia;
      document.getElementById(`bottle${bottleNum}-total`).textContent = total.toFixed(1) + ' mL';
      
      // Update bottle amounts text below each bottle
      if (total === 0) {
        document.getElementById(`bottle${bottleNum}-amounts`).textContent = 'Empty';
      } else {
        document.getElementById(`bottle${bottleNum}-amounts`).textContent = 
          `E:${bottle.epsom.toFixed(0)} W:${bottle.water.toFixed(0)} A:${bottle.ammonia.toFixed(0)}`;
      }
      
      // Update bottle liquid level and color
      const maxHeight = 140;
      const maxVolume = 500;
      const liquidHeight = Math.min((total / maxVolume) * maxHeight, maxHeight);
      const liquidY = 170 - liquidHeight;
      
      const liquidElement = document.getElementById(`bottle${bottleNum}-liquid`);
      liquidElement.setAttribute('y', liquidY);
      liquidElement.setAttribute('height', liquidHeight);
      
      // Update color
      const flaskColor = calculateFlaskColor(bottleNum);
      liquidElement.setAttribute('fill', flaskColor.hex);
    }

    function updateStatus(message) {
      document.getElementById('status-text').textContent = message;
    }
    
    function selectPart(part) {
      currentPart = part;
      
      // Update button styles
      document.querySelectorAll('.experiment-part-btn').forEach(btn => {
        btn.style.fontWeight = 'normal';
        btn.style.borderWidth = '2px';
      });
      
      const selectedBtn = document.getElementById(`${part}-btn`);
      selectedBtn.style.fontWeight = 'bold';
      selectedBtn.style.borderWidth = '3px';
      
      // Update description
      const descEl = document.getElementById('experiment-description');
      if (part === 'part1') {
        descEl.textContent = 'Part 1: Vary the amount of ammonia with constant Epsom salt (1 Tbsp per bottle). Observe how ammonia amount affects precipitate formation.';
      } else {
        descEl.textContent = 'Part 2: Vary the amount of Epsom salt with constant ammonia (1/3 cup per bottle). Observe how Epsom salt amount affects precipitate formation.';
      }
      
      updateStatus(`${part === 'part1' ? 'Part 1' : 'Part 2'} selected. Select a bottle to begin adding chemicals.`);
    }

    function resetExperiment() {
      currentPart = null;
      selectedBottle = null;
      
      // Reset all bottles
      bottles = {
        1: { epsom: 0, water: 0, ammonia: 0 },
        2: { epsom: 0, water: 0, ammonia: 0 },
        3: { epsom: 0, water: 0, ammonia: 0 }
      };
      
      // Update displays
      for (let i = 1; i <= 3; i++) {
        updateBottleDisplay(i);
      }
      
      // Reset button styles
      document.querySelectorAll('.experiment-part-btn').forEach(btn => {
        btn.style.fontWeight = 'normal';
        btn.style.borderWidth = '2px';
      });
      
      document.querySelectorAll('.bottle-selector-btn').forEach(btn => {
        btn.style.fontWeight = 'normal';
        btn.style.borderWidth = '2px';
      });
      
      document.getElementById('selected-bottle-text').textContent = 'No bottle selected';
      document.getElementById('experiment-description').textContent = '';
      
      // Disable chemical buttons
      document.querySelectorAll('.add-chemical-btn').forEach(btn => {
        btn.disabled = true;
      });
      
      updateStatus('Choose Part 1 or Part 2 to begin the experiment.');
    }

    async function onConfigChange(config) {
      const appWrapper = document.getElementById('app-wrapper');
      const surfaces = document.querySelectorAll('.border-2');
      const allText = document.querySelectorAll('body, button, p, h1, h2, h3, span, div, text');
      
      const backgroundColor = config.background_color || defaultConfig.background_color;
      const surfaceColor = config.surface_color || defaultConfig.surface_color;
      const textColor = config.text_color || defaultConfig.text_color;
      const primaryActionColor = config.primary_action_color || defaultConfig.primary_action_color;
      const secondaryActionColor = config.secondary_action_color || defaultConfig.secondary_action_color;
      const fontFamily = config.font_family || defaultConfig.font_family;
      const fontSize = config.font_size || defaultConfig.font_size;
      
      appWrapper.style.backgroundColor = backgroundColor;
      
      surfaces.forEach(el => {
        el.style.backgroundColor = surfaceColor;
        el.style.borderColor = textColor + '33';
      });
      
      allText.forEach(el => {
        el.style.color = textColor;
        el.style.fontFamily = `${fontFamily}, system-ui, sans-serif`;
      });
      
      document.documentElement.style.fontSize = `${fontSize}px`;
      
      const allButtons = document.querySelectorAll('.add-chemical-btn, .bottle-selector-btn, .experiment-part-btn');
      allButtons.forEach(btn => {
        btn.style.backgroundColor = primaryActionColor;
        btn.style.color = surfaceColor;
        if (btn.disabled) {
          btn.style.opacity = '0.5';
          btn.style.cursor = 'not-allowed';
        }
      });
      
      document.getElementById('reset-btn').style.color = textColor;
      document.getElementById('reset-btn').style.borderColor = secondaryActionColor;
      
      const chemicalContainers = document.querySelectorAll('.border');
      chemicalContainers.forEach(el => {
        el.style.borderColor = textColor + '33';
      });
      
      document.getElementById('lab-title').textContent = config.lab_title || defaultConfig.lab_title;
      document.getElementById('instruction-text').textContent = config.instruction_text || defaultConfig.instruction_text;
      document.getElementById('reset-btn').textContent = config.button_text || defaultConfig.button_text;
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Part selection buttons
      document.getElementById('part1-btn').addEventListener('click', (e) => {
        e.preventDefault();
        selectPart('part1');
      });
      
      document.getElementById('part2-btn').addEventListener('click', (e) => {
        e.preventDefault();
        selectPart('part2');
      });
      
      // Bottle selection buttons
      document.querySelectorAll('.bottle-selector-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          selectBottle(parseInt(btn.dataset.bottle));
        });
      });
      
      // Reset button
      document.getElementById('reset-btn').addEventListener('click', (e) => {
        e.preventDefault();
        resetExperiment();
      });
      
      // Chemical addition buttons
      document.querySelectorAll('.add-chemical-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          if (!btn.disabled) {
            const chemical = btn.dataset.chemical;
            const amount = btn.dataset.amount;
            addChemicalToBottle(chemical, amount);
          }
        });
      });
    });

    if (window.elementSdk) {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange,
        mapToCapabilities: (config) => ({
          recolorables: [
            {
              get: () => config.background_color || defaultConfig.background_color,
              set: (value) => {
                config.background_color = value;
                window.elementSdk.setConfig({ background_color: value });
              }
            },
            {
              get: () => config.surface_color || defaultConfig.surface_color,
              set: (value) => {
                config.surface_color = value;
                window.elementSdk.setConfig({ surface_color: value });
              }
            },
            {
              get: () => config.text_color || defaultConfig.text_color,
              set: (value) => {
                config.text_color = value;
                window.elementSdk.setConfig({ text_color: value });
              }
            },
            {
              get: () => config.primary_action_color || defaultConfig.primary_action_color,
              set: (value) => {
                config.primary_action_color = value;
                window.elementSdk.setConfig({ primary_action_color: value });
              }
            },
            {
              get: () => config.secondary_action_color || defaultConfig.secondary_action_color,
              set: (value) => {
                config.secondary_action_color = value;
                window.elementSdk.setConfig({ secondary_action_color: value });
              }
            }
          ],
          borderables: [],
          fontEditable: {
            get: () => config.font_family || defaultConfig.font_family,
            set: (value) => {
              config.font_family = value;
              window.elementSdk.setConfig({ font_family: value });
            }
          },
          fontSizeable: {
            get: () => config.font_size || defaultConfig.font_size,
            set: (value) => {
              config.font_size = value;
              window.elementSdk.setConfig({ font_size: value });
            }
          }
        }),
        mapToEditPanelValues: (config) => new Map([
          ['lab_title', config.lab_title || defaultConfig.lab_title],
          ['instruction_text', config.instruction_text || defaultConfig.instruction_text],
          ['analyte_label', config.analyte_label || defaultConfig.analyte_label],
          ['titrant_label', config.titrant_label || defaultConfig.titrant_label],
          ['button_text', config.button_text || defaultConfig.button_text]
        ])
      });
